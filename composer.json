{
  "name": "groton-school/slim-norms",
  "description": "Define some normal interfaces and abstract classes for working with the Slim Framework",
  "version": "2.1.1",
  "license": "GPL-3.0",
  "autoload": {
    "psr-4": {
      "GrotonSchool\\Slim\\Norms\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Seth Battis",
      "email": "sbattis@groton.org"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  },
  "require": {
    "php-di/php-di": "^7.0",
    "psr/http-message": "^2.0",
    "slim/http": "^1.4",
    "slim/slim": "^4.12"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "*",
    "marcocesarato/php-conventional-changelog": "*"
  },
  "scripts": {
    "release": [
      "conventional-changelog -c",
      "git push",
      "git push --tags",
      "git checkout main",
      "git merge dev",
      "git push",
      "git checkout dev"
    ]
  }
}
